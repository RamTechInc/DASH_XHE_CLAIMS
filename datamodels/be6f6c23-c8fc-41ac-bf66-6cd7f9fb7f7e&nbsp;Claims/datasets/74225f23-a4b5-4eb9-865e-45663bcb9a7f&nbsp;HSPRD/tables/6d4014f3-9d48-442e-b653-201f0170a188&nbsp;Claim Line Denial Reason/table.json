    "configOptions": {
        "importQuery": "SELECT DISTINCT \r\nCLAIM.CSV_CLM_ID AS CLAIM_ID,\r\nCLAIM.CSV_LN_NUM AS CLAIM_LINE,\r\nCLAIM.CSV_CLM_ID || ' ' || CLAIM.CSV_LN_NUM AS LINE_ID,\r\nERRMS.CMSG_ID AS DENIAL_CD,\r\nINITCAP(ERRMS.CMSG_DESC) AS DENIAL_REASON\r\n\r\nFROM       \tHS.CSV_CLM_SRV\t\tAS CLAIM\r\nJOIN        HS.CDT_CLM_DT       AS CDT ON CLAIM.CSV_CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nLEFT JOIN\tHS.CSER_CSV_ERROR\tAS LIERR ON CLAIM.CSV_CLM_ID = LIERR.CSER_CSV_CLM_ID AND CLAIM.CSV_LN_NUM = LIERR.CSER_CSV_LN_NUM AND LIERR.CSER_OVRID_CD IS NULL\r\nLEFT JOIN\tHS.CMSG_CLM_MSG\tAS ERRMS ON LIERR.CSER_CD  = ERRMS.CMSG_ID AND ERRMS.CMSG_SUS_DN_CD = 'D'\r\nWITH UR"
    },
