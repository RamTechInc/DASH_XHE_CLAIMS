    "configOptions": {
        "importQuery": "WITH PAID AS (\r\nSELECT\r\nCSAJ_CSV_CLM_ID,\r\nCSAJ_CSV_LN_NUM,\r\nCSAM_AMT,\r\n(CSAM_AMT -SUM(CSAJ_AMT)) AS PAID_AMT\r\nFROM HS.CSAM_CSV_AMT\r\nLEFT JOIN HS.CSAJ_CSV_ADJ ON CSAM_CSV_CLM_ID = CSAJ_CSV_CLM_ID AND CSAM_CSV_LN_NUM = CSAJ_CSV_LN_NUM\r\nWHERE CSAM_AMT_QUAL = 'E9'\r\nGROUP BY CSAJ_CSV_CLM_ID,CSAJ_CSV_LN_NUM,CSAM_AMT\r\nWITH UR), ADJUST AS\r\n(SELECT\r\nCSAJ_CSV_CLM_ID,\r\nCSAJ_CSV_LN_NUM,\r\nCSAJ_AMT,\r\nCSAJ_RSN_CD,\r\nCSAJ_GRP_CD\r\nFROM HS.CSAJ_CSV_ADJ\r\nWHERE CSAJ_RSN_CD IN ('UCR','253')\r\nOR (CSAJ_RSN_CD IN (SELECT CTY_TYPE FROM HS.CTY_CNSTRNT_TYPE WHERE CTY_DESC LIKE '%DED%' WITH UR)\r\nOR CSAJ_RSN_CD IN (SELECT CTY_TYPE FROM HS.CTY_CNSTRNT_TYPE WHERE CTY_DESC NOT LIKE '%DED%' AND CTY_MIN_MAX NOT IN ('M','R','L') WITH UR))\r\nWITH UR)\r\nSELECT DISTINCT\r\nCSV.CSV_CLM_ID AS CLAIM_ID,\r\nCSV.CSV_LN_NUM AS LINE_NUM,\r\nCSV.CSV_CLM_ID || ' ' || CSV.CSV_LN_NUM AS LINE_ID,\r\nNVL(PAID.CSAM_AMT,0) AS LINE_BILLED_AMT,\r\nNVL(UCR.CSAJ_AMT,0) + NVL(ADDL_UCR_ADJ.CSAJ_AMT,0) AS LINE_UCR, \r\nNVL(PAID.CSAM_AMT,0) - (NVL(UCR.CSAJ_AMT,0) + NVL(ADDL_UCR_ADJ.CSAJ_AMT,0)) AS LINE_ALLOWED_AMOUNT, \r\nNVL(DED.CSAJ_AMT,0) AS LINE_DEDUCTIBLE,\r\nNVL(COP.CSAJ_AMT,0) AS LINE_COPAY_COINSURANCE,\r\nNVL(SEQ.CSAJ_AMT,0) AS LINE_SEQUESTRATION,\r\nNVL(PAID_AMT,0) AS LINE_PAID_AMT\r\nFROM HS.CSV_CLM_SRV AS CSV\r\nJOIN HS.CDT_CLM_DT AS CDT ON CSV.CSV_CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nLEFT JOIN ADJUST AS UCR ON CSV.CSV_CLM_ID = UCR.CSAJ_CSV_CLM_ID AND CSV.CSV_LN_NUM = UCR.CSAJ_CSV_LN_NUM AND UCR.CSAJ_GRP_CD = 'NC' AND UCR.CSAJ_RSN_CD = 'UCR'\r\nLEFT JOIN HS.CSAJ_CSV_ADJ AS ADDL_UCR_ADJ ON CSV.CSV_CLM_ID = ADDL_UCR_ADJ.CSAJ_CSV_CLM_ID AND CSV.CSV_LN_NUM = ADDL_UCR_ADJ.CSAJ_CSV_LN_NUM AND ADDL_UCR_ADJ.CSAJ_CMSG_IND = 'Y' and ADDL_UCR_ADJ.CSAJ_CAT_IND IS NULL\r\nLEFT JOIN ADJUST AS DED ON CSV.CSV_CLM_ID = DED.CSAJ_CSV_CLM_ID AND CSV.CSV_LN_NUM = DED.CSAJ_CSV_LN_NUM AND DED.CSAJ_RSN_CD IN (SELECT CTY_TYPE FROM HS.CTY_CNSTRNT_TYPE WHERE CTY_DESC LIKE '%DED%' WITH UR)\r\nLEFT JOIN ADJUST AS COP ON CSV.CSV_CLM_ID = COP.CSAJ_CSV_CLM_ID AND CSV.CSV_LN_NUM = COP.CSAJ_CSV_LN_NUM AND COP.CSAJ_GRP_CD = 'PR' AND COP.CSAJ_RSN_CD IN (SELECT CTY_TYPE FROM HS.CTY_CNSTRNT_TYPE WHERE CTY_DESC NOT LIKE '%DED%' AND CTY_MIN_MAX NOT IN ('M','R','L') WITH UR)\r\nLEFT JOIN ADJUST AS SEQ ON CSV.CSV_CLM_ID = SEQ.CSAJ_CSV_CLM_ID AND CSV.CSV_LN_NUM = SEQ.CSAJ_CSV_LN_NUM AND SEQ.CSAJ_RSN_CD = '253'\r\nLEFT JOIN PAID AS PAID ON CSV.CSV_CLM_ID = PAID.CSAJ_CSV_CLM_ID AND CSV.CSV_LN_NUM = PAID.CSAJ_CSV_LN_NUM\r\n\r\nWITH UR"
    },
