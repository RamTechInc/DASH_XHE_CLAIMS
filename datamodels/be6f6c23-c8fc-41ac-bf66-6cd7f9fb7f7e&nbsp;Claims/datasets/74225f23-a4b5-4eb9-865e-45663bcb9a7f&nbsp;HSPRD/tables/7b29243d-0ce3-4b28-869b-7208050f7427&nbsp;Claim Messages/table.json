    "configOptions": {
        "importQuery": "SELECT DISTINCT \r\nCLAIM.CLM_ID AS CLAIM_ID,\r\nCERRMS.CMSG_ID AS MSG_CD,\r\nINITCAP(CERRMS.CMSG_DESC) AS MSG_DESC\r\n\r\nFROM        HS.CLM_CLAIM\t\tAS CLAIM\r\nJOIN        HS.CDT_CLM_DT       AS CDT ON CLAIM.CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nLEFT JOIN\tHS.CER_CLM_ERROR\tAS CLERR ON CLAIM.CLM_ID = CLERR.CER_CLM_ID AND CLERR.CER_OVRID_CD IS NULL\r\nLEFT JOIN\tHS.CMSG_CLM_MSG\tAS CERRMS ON CLERR.CER_CD  = CERRMS.CMSG_ID \r\n\r\nWITH UR"
    },
