    "configOptions": {
        "importQuery": "SELECT DISTINCT \r\nCLAIM.CSV_CLM_ID AS CLAIM_ID,\r\nCLAIM.CSV_LN_NUM AS CLAIM_LINE,\r\nCLAIM.CSV_CLM_ID || ' ' || CLAIM.CSV_LN_NUM AS LINE_ID,\r\nCSDC.CSDC_NDC_ID\tAS LINE_NDC,\r\nCSDC.CSDC_QUAL\t\tAS LINE_CSDC_QUAL\r\n\r\nFROM       \t    HS.CSV_CLM_SRV\t\tAS CLAIM\r\nJOIN        \tHS.CDT_CLM_DT       AS CDT ON CLAIM.CSV_CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nLEFT JOIN\t\tHS.CSDC_CSV_DG_CMPD AS CSDC ON CLAIM.CSV_CLM_ID = CSDC.CSDC_CSV_CLM_ID AND CLAIM.CSV_LN_NUM = CSDC.CSDC_CSV_LN_NUM\r\n\r\nWITH UR"
    },
