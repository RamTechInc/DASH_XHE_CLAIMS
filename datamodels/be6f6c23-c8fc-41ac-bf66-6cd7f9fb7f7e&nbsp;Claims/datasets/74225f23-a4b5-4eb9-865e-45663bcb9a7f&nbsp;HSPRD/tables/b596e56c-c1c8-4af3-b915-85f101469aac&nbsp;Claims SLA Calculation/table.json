    "configOptions": {
        "importQuery": "SELECT DISTINCT\r\nCEV.CEV_CLM_ID \t\t\tAS CLAIM_ID,\r\nCASE \r\n\tWHEN CLM.CLM_FC_CD IN ('21','22','23') THEN 'Yes'\r\n\tELSE 'No'\r\nEND\t\t\t\t\tAS SNF_IND,\r\nINITCAP(TCL.TCL_TYPE_DESC) \tAS SLA_STATUS,\r\nCEV.CEV_EV_DT \t\t\t\tAS SLA_DT,\r\nFIRST_DAY(CEV.CEV_EV_DT)    AS SLA_DT_MONTH,\r\nDAYS(CEV.CEV_EV_DT) - DAYS(CDT.CDT_DT) \r\n\t\t\t\t\t\tAS SLA_AGE,\r\nAL1.CEV_EV_DT\t\t\tAS \"First Allowed Date\" -- added due to CHC issue\r\n\r\nFROM HS.CEV_CLM_EV AS CEV\r\nJOIN HS.CLM_CLAIM AS CLM ON CEV.CEV_CLM_ID = CLM.CLM_ID\r\nJOIN HS.CDT_CLM_DT       AS CDT ON CEV.CEV_CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nJOIN HS.TCL_TYPE_CD_LOOKUP AS TCL  ON TRIM(CEV.CEV_TYPE) = TCL.TCL_TYPE_CODE AND TCL.TCL_ID = 84\r\n\r\n-- added due to CHC issue\r\nLEFT JOIN HS.CEV_CLM_EV AS AL1 ON CEV.CEV_CLM_ID = AL1.CEV_CLM_ID AND AL1.CEV_DEL_TS IS NULL AND AL1.CEV_TYPE = 'ALW' AND AL1.CEV_ADD_TS = (SELECT CEV_ADD_TS FROM HS.CEV_CLM_EV WHERE CEV_CLM_ID = AL1.CEV_CLM_ID AND CEV_DEL_TS IS NULL AND CEV_TYPE = 'ALW' ORDER BY CEV_ADD_TS ASC FETCH FIRST 1 ROWS ONLY WITH UR)\r\n-- added due to CHC issue\r\n\r\nWHERE CEV.CEV_DEL_TS IS NULL\r\nAND CEV.CEV_RUN_ID IS NOT NULL AND CEV.CEV_RUN_ID !=0\r\nAND TRIM(CEV.CEV_TYPE) IN ('PD','DN')\r\nAND CEV.CEV_ADD_TS = (SELECT CEV_ADD_TS FROM HS.CEV_CLM_EV WHERE CEV_CLM_ID = CEV.CEV_CLM_ID AND CEV_DEL_TS IS NULL AND CEV_RUN_ID IS NOT NULL AND CEV_RUN_ID !=0 AND TRIM(CEV_TYPE) IN ('PD','DN') ORDER BY CEV_ADD_TS ASC FETCH FIRST 1 ROWS ONLY WITH UR)\r\n\r\nWITH UR"
    },
