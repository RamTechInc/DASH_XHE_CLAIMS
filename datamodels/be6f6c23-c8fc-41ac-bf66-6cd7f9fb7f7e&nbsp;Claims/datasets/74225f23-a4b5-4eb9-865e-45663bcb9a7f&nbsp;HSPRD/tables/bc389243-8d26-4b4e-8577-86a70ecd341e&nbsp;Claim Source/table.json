    "configOptions": {
        "importQuery": "SELECT DISTINCT\r\nCEV.CEV_CLM_ID,\r\nCASE\r\n\tWHEN LEFT(CEV.CEV_USER_ID,4) = 'EDI8' THEN 'EDI'\r\n\tWHEN LEFT(CEV.CEV_USER_ID,3) = 'OCR' THEN 'Paper'\r\n\tWHEN TRIM(CEV.CEV_USER_ID) = 'CONVERT' THEN 'Convert'\r\n\tELSE 'Manual'\r\nEND\t\t\t\t\t\tAS SOURCE_FORM,\r\nCEV.CEV_USER_ID             AS ORIGIN_USER_ID,\r\nCEV.CEV_EV_DT\t\t\t\tAS ORIGIN_DATE\r\n\r\nFROM HS.CEV_CLM_EV AS CEV\r\nJOIN        HS.CDT_CLM_DT       AS CDT ON CEV.CEV_CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nWHERE CEV.CEV_DEL_TS IS NULL\r\nAND CEV.CEV_ADD_TS = (SELECT CEV_ADD_TS FROM HS.CEV_CLM_EV WHERE CEV_CLM_ID = CEV.CEV_CLM_ID AND CEV_DEL_TS IS NULL ORDER BY CEV_ADD_TS ASC FETCH FIRST 1 ROWS ONLY WITH UR)\r\nWITH UR"
    },
