    "configOptions": {
        "importQuery": "SELECT DISTINCT \r\nCDT.CDT_CLM_ID AS CLAIM_ID,\r\nCDT.CDT_DT AS RECEIPT_DT,\r\nFIRST_DAY(CDT.CDT_DT) || CLM.CLM_MBR_BASE_PPT_ID AS FIRST_DAY_RCPT_DT,\r\nCASE \r\n\tWHEN DAYOFWEEK(CDT.CDT_DT) = '7' THEN ADD_DAYS(CDT.CDT_DT,2) \r\n\tWHEN DAYOFWEEK(CDT.CDT_DT) = '1' THEN ADD_DAYS(CDT.CDT_DT,1)\r\n\tELSE CDT.CDT_DT\r\nEND\t\t\t\t\t\tAS ADJ_RECEIPT_DT\r\n\r\nFROM HS.CDT_CLM_DT \tAS CDT\r\nJOIN\tHS.CLM_CLAIM\tAS CLM ON CDT.CDT_CLM_ID = CLM.CLM_ID\r\nWHERE CDT.CDT_DT_QUAL = '050' \r\nAND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\n\r\nWITH UR"
    },
