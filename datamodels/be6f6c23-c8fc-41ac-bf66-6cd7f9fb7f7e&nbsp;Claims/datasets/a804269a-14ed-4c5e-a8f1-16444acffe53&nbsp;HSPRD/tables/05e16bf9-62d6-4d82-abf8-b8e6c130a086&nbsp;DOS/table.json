    "configOptions": {
        "importQuery": "SELECT DISTINCT \nDOS.CDT_CLM_ID AS CLAIM_ID, \nDOS.CDT_DT AS DOS, \nDOS.CDT_TO_DT AS DOS_TO \n\nFROM HS.CDT_CLM_DT AS DOS\nJOIN HS.CDT_CLM_DT AS CDT ON DOS.CDT_CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\n\nWHERE DOS.CDT_DT_QUAL = '150' \n\nWITH UR"
