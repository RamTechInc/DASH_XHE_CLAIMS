    "configOptions": {
        "importQuery": "SELECT DISTINCT \r\nCLAIM.CSV_CLM_ID AS CLAIM_ID,\r\nCLAIM.CSV_LN_NUM AS CLAIM_LINE,\r\nCLAIM.CSV_CLM_ID || ' ' || CLAIM.CSV_LN_NUM AS LINE_ID,\r\nCERRMS.CMSG_ID AS LINE_MSG_CD,\r\nINITCAP(CERRMS.CMSG_DESC) AS LINE_MSG_DESC\r\n\r\nFROM       \tHS.CSV_CLM_SRV\t\tAS CLAIM\r\nJOIN        HS.CDT_CLM_DT       AS CDT ON CLAIM.CSV_CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nLEFT JOIN\tHS.CSER_CSV_ERROR\tAS CLERR ON CLAIM.CSV_CLM_ID = CLERR.CSER_CSV_CLM_ID AND CLAIM.CSV_LN_NUM = CLERR.CSER_CSV_LN_NUM AND CLERR.CSER_OVRID_CD IS NULL\r\nLEFT JOIN\tHS.CMSG_CLM_MSG\tAS CERRMS ON CLERR.CSER_CD  = CERRMS.CMSG_ID \r\n\r\nWITH UR"
    },
