    "configOptions": {
        "importQuery": "SELECT DISTINCT \r\nINS.INS_CUS_ID\t\tAS HSN,\r\nCAL.DATEOFMONTH || CCP.CCP_PPT_ID\t\tAS MEMBERSHIP_PLAN_ID,\r\nCAL.DATEOFMONTH\t    AS \"Membership Month\"\r\n\r\n\r\nFROM \tHS.INS_INSURED\t\t\tAS INS\r\nJOIN \tHS.CCP_CUS_CNTRCT_PRD\tAS CCP ON INS.INS_CCN_ID = CCP.CCP_CCN_ID AND CCP.CCP_DEL_TS IS NULL AND NVL(CCP.CCP_TERM_DT,'12/31/9999') > CCP.CCP_EFF_DT\r\nJOIN \tBPAAS.MONTHLY_CAL \t\tAS CAL ON CAL.DATEOFMONTH BETWEEN CCP.CCP_EFF_DT AND NVL(CCP.CCP_TERM_DT,'12/31/9999') AND CAL.DATEOFMONTH BETWEEN FIRST_DAY(CURRENT_DATE - 2 YEAR) AND CURRENT_DATE \r\n\r\nWITH UR"
    },
