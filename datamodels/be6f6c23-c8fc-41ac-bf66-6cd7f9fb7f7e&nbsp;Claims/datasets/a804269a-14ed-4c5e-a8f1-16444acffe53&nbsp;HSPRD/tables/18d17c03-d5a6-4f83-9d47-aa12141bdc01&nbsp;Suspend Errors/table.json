    "configOptions": {
        "importQuery": "SELECT DISTINCT \nCLAIM.CLM_ID AS CLAIM_ID,\nCERRMS.CMSG_ID AS ERROR_CD,\nINITCAP(CERRMS.CMSG_DESC) AS ERROR_MESSAGE\n\nFROM        HS.CLM_CLAIM\t\tAS CLAIM\nJOIN        HS.CDT_CLM_DT       AS CDT ON CLAIM.CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\nLEFT JOIN\tHS.CER_CLM_ERROR\tAS CLERR ON CLAIM.CLM_ID = CLERR.CER_CLM_ID AND CLERR.CER_OVRID_CD IS NULL\nLEFT JOIN\tHS.CMSG_CLM_MSG\tAS CERRMS ON CLERR.CER_CD  = CERRMS.CMSG_ID AND CERRMS.CMSG_SUS_DN_CD = 'S'\n\nWITH UR"
    },
