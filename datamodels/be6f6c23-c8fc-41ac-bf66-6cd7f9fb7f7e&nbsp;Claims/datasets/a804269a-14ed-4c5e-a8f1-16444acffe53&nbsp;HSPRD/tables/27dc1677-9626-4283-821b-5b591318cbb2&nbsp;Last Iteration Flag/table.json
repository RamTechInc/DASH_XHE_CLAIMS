    "configOptions": {
        "importQuery": "SELECT CLM.CLM_ID AS CLAIM_ID,\r\nCASE\r\n\tWHEN CLM1.CLM_CLM_ID IS NULL THEN 'Yes'\r\n\tELSE 'No'\r\nEND AS \"Last Iteration FLag\"\r\n\r\nFROM HS.CLM_CLAIM AS CLM \r\nJOIN HS.CDT_CLM_DT   AS CDT  ON CLM.CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nLEFT JOIN HS.CLM_CLAIM AS CLM1 ON CLM.CLM_ID = CLM1.CLM_CLM_ID\r\n\r\nWITH UR"
    },
