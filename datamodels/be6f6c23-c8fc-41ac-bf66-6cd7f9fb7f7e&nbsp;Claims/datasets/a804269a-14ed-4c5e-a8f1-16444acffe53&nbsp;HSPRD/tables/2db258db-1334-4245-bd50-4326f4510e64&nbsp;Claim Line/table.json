    "configOptions": {
        "importQuery": "SELECT DISTINCT\nCSV_CLM_ID      AS CLAIM_ID,\nCSV_LN_NUM      AS LINE_NUM,\nCSV_CLM_ID || ' ' || CSV_LN_NUM AS LINE_ID,\nPPTL.PPTL_RULE_VAL_C    AS \"Claim Network Status\",\nCSV_PRC_ID_QUAL AS CODE_QUAL,\nCSV_PRC_CD      AS CODE,\nCSV_PRC_MOD_1   AS MOD1,\nCSV_PRC_MOD_2   AS MOD2,\nCSV_PRC_MOD_3   AS MOD3,\nCSV_PRC_MOD_4   AS MOD4,\nCSV_SRV_QTY     AS SERV_QTY,\nCSV_I_UNIT_RT   AS I_UNIT_RT,\nCSV_REV_CD      AS REV_CD,\nCSV_SVP_CD\t    AS POS,\nCSV_FSC_ID      AS LINE_FEE_ID,\nCSV_PRB_ID      AS \"Benefit ID\"\n\nFROM HS.CSV_CLM_SRV\nJOIN HS.CDT_CLM_DT       AS CDT ON CSV_CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\nLEFT JOIN HS.PPTL_PPT_RULE AS PPTL ON CSV_PPT_ID = PPTL.PPTL_PPT_ID AND PPTL.PPTL_RULE_QUAL = 'TS' AND PPTL.PPTL_DEL_TS IS NULL\nWITH UR"
    },
