    "configOptions": {
        "importQuery": "SELECT DISTINCT\r\nCLM.CLM_ID,\r\nDCN.CRF_REF_NUM AS DCN\r\n\r\nFROM        HS.CLM_CLAIM        AS CLM\r\nJOIN        HS.CDT_CLM_DT       AS CDT ON CLM.CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nLEFT JOIN \tHS.CRF_CLM_REF \t\tAS DCN ON CLM.CLM_ID = DCN.CRF_CLM_ID AND DCN.CRF_REF_QUAL = 'D9'\r\nWITH UR"
    },
