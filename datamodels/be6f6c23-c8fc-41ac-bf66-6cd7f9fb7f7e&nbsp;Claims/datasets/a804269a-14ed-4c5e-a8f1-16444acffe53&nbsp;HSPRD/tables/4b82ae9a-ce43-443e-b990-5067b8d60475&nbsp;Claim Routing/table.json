    "configOptions": {
        "importQuery": "SELECT DISTINCT \r\nCLM.CLM_ID\t\tAS CLAIM_ID,\r\nCLAUD.CAU_REQ_TO\tAS QUEUE,\r\nCLAUD.CAU_PRC_DT\tAS QUEUE_DT,\r\nCASE\r\n\tWHEN TRIM(CLAUD.CAU_REQ_TO) IN (SELECT TRIM(CLM_QUEUE) FROM BPAAS.CLM_QUEUE_OWNER WHERE CLM_QUEUE_OWNER = 'CLIENT' WITH UR) THEN 'Client'\r\n\tWHEN TRIM(CLAUD.CAU_REQ_TO) NOT IN (SELECT TRIM(CLM_QUEUE) FROM BPAAS.CLM_QUEUE_OWNER WHERE CLM_QUEUE_OWNER = 'CLIENT' WITH UR) THEN 'RAM'\r\nEND\t\t\t\tAS QUEUE_OWNER\r\n\r\nFROM        HS.CLM_CLAIM        AS CLM\r\nJOIN        HS.CDT_CLM_DT       AS CDT ON CLM.CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nLEFT JOIN\tHS.CAU_CLM_AUD\t\tAS CLAUD ON CLM.CLM_ID = CLAUD.CAU_CLM_ID AND CLAUD.CAU_REQ_TO IS NOT NULL\r\n\r\nWITH UR"
    },
