    "configOptions": {
        "importQuery": "SELECT DISTINCT\r\nDOS.CSDT_CSV_CLM_ID\t\tAS CLAIM_ID,\r\nDOS.CSDT_CSV_LN_NUM\t\tAS CLAIM_LINE,\r\nDOS.CSDT_CSV_CLM_ID\t || ' ' || CSDT_CSV_LN_NUM AS LINE_ID,\r\nDOS.CSDT_DT\t\t\t\tAS LINE_DOS,\r\nDOS.CSDT_TO_DT\t\t\tAS LINE_DOS_TO\r\n\r\nFROM HS.CSDT_CSV_DT     AS DOS\r\nJOIN HS.CDT_CLM_DT       AS CDT ON DOS.CSDT_CSV_CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\n\r\nWHERE CSDT_DT_QUAL = '150'\r\n\r\nWITH UR"
    },
