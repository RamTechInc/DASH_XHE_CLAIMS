    "configOptions": {
        "importQuery": "SELECT DISTINCT\r\nCLM.CLM_ID\t\tAS CLAIM_ID,\r\nPRI.CHI_CD\t\tAS PRIMARY_DIAG,\r\nINITCAP(PRD.DGN_DSC)\r\n                AS PRIMARY_DIAG_DESC,\r\nSEC.CHI_CD\t\tAS SECOND_DIAG,\r\nINITCAP(SED.DGN_DSC)\r\n                AS SECOND_DIAG_DESC,\r\nTIR.CHI_CD\t\tAS THIRD_DIAG,\r\nINITCAP(TID.DGN_DSC)\r\n                AS THIRD_DIAG_DESC\r\n\r\n\r\nFROM      HS.CLM_CLAIM        AS CLM\r\nJOIN      HS.CDT_CLM_DT       AS CDT ON CLM.CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nLEFT JOIN HS.CHI_CLM_HLTH_CD\tAS PRI ON CLM.CLM_ID = PRI.CHI_CLM_ID AND PRI.CHI_CD_QUAL = 'ABK'\r\nLEFT JOIN HS.DGN_DIAGNOSIS\tAS PRD ON PRI.CHI_CD = PRD.DGN_CD_VAL AND PRD.DGN_EXP_DT IS NULL\r\nLEFT JOIN HS.CHI_CLM_HLTH_CD\tAS SEC ON CLM.CLM_ID = SEC.CHI_CLM_ID AND SEC.CHI_CD_QUAL = 'ASD'\r\nLEFT JOIN HS.DGN_DIAGNOSIS\tAS SED ON SEC.CHI_CD = SED.DGN_CD_VAL AND SED.DGN_EXP_DT IS NULL\r\nLEFT JOIN HS.CHI_CLM_HLTH_CD\tAS TIR ON CLM.CLM_ID = TIR.CHI_CLM_ID AND TIR.CHI_CD_QUAL = 'ATD'\r\nLEFT JOIN HS.DGN_DIAGNOSIS\tAS TID ON TIR.CHI_CD = TID.DGN_CD_VAL AND TID.DGN_EXP_DT IS NULL\r\n\r\nWITH UR"
    },
