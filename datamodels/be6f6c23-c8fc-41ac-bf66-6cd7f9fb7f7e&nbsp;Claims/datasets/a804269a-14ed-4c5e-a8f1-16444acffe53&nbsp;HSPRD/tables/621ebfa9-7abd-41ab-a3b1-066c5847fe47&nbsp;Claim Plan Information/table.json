    "configOptions": {
        "importQuery": "SELECT DISTINCT\nnull            AS PLAN_ID,\nnull\t\t\tAS PRODUCT,\nnull\t\t\tAS PLAN,\nnull\t\t\tAS PBP,\nnull\t\t\tAS PLAN_NAME\n\nFROM BPAAS.MONTHLY_CAL\n\nUNION ALL\n\nSELECT DISTINCT\nPPT.PPT_ID                  AS PLAN_ID,\nPPT.PPT_PRD_SHT_NM\t\t\tAS PRODUCT,\nPPT.PPT_PLN_SHT_NM\t\t\tAS PLAN,\nPPTA.PPTA_GRP\t\t\t\tAS PBP,\nPPT.PPT_DESC\t\t\t\tAS PLAN_NAME\n\nFROM HS.PPT_PRD_PLAN_TIER AS PPT\nJOIN HS.PPTA_PPT_ALIAS AS PPTA\tON PPT.PPT_ID = PPTA.PPTA_PPT_ID AND PPTA.PPTA_DEL_TS IS NULL AND PPTA.PPTA_CD = '004'\n                                \nWITH UR"
    },
