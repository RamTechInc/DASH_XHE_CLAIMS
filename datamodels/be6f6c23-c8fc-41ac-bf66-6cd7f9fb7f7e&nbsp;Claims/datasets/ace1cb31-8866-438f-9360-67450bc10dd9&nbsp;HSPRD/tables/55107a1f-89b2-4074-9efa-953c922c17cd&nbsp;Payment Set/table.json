    "configOptions": {
        "importQuery": "SELECT \r\nCLM.CLM_ID,\r\nPST.PST_ID\t\t\tAS PAYMENT_SET_ID,\r\nDATE(PSHI.PSHI_STATUS_DT)\tAS PAYMENT_DATE,\r\nMONTH(PSHI.PSHI_STATUS_DT) AS \"Payment Month\",\r\nPSHI.PSHI_PAYEE_NAME\tAS PAYEE_NAME,\r\nPTYP.TCL_TYPE_DESC\t\tAS PAYMENT_TYPE,\r\nPST.PST_AMT\t\t\tAS PAYMENT_SET_PAID_AMT,\r\nPST.PST_TIMELY_INT_AMT\tAS PAYMENT_INTEREST_AMT,\r\nPSHI.PSHI_TRAN_NUM      AS \"Check Number\",\r\nPSHI.PSHI_CHECK_AMT\t\tAS CHECK_AMOUNT,\r\nPSHI.PSHI_TRAN_NUM\t\tAS TRAN_NUMBER,\r\nPSHI.PSHI_CHECK_DT\t\tAS CHECK_DATE,\r\nCASE\r\n    WHEN CSEV.CSEV_CSV_CLM_ID IS NULL THEN PSTS.TCL_TYPE_DESC\r\n    WHEN CSEV.CSEV_CSV_CLM_ID IS NOT NULL AND PTYP.TCL_TYPE_DESC = 'CLAIM PAYMENT' THEN 'PARTIAL DENIAL'\r\nEND\t\tAS PAYMENT_STATUS,\r\nSUM(NVL(CLR.CLR_AMT,0))\t\t\tAS CLAIM_RECOUPMENT\r\n\r\nFROM \tHS.CLM_CLAIM        \tAS CLM\r\nJOIN      HS.CDT_CLM_DT       \tAS CDT ON CLM.CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nLEFT JOIN HS.CPY_CLM_PAY      \tAS CPY ON CLM.CLM_ID = CPY.CPY_CLM_ID\r\nLEFT JOIN HS.PST_PMT_SET           AS PST ON CPY.CPY_PST_ID = PST.PST_ID\r\nLEFT JOIN HS.PSHI_PMT_SET_HISTORY  AS PSHI ON PST.PST_ID = PSHI.PSHI_PST_ID AND PSHI.PSHI_DEL_TS IS NULL AND PSHI.PSHI_PAYMENT_TYPE IN ('001','003','004','005') AND PSHI.PSHI_STATUS_CD IN ('001','005')\r\n                                    AND PSHI.PSHI_ADD_TS = (SELECT PSHI_ADD_TS FROM HS.PSHI_PMT_SET_HISTORY WHERE PSHI.PSHI_PST_ID = PSHI_PST_ID AND PSHI.PSHI_CHECK_DT = PSHI_CHECK_DT AND PSHI_PAYMENT_TYPE IN ('001','003','004','005') AND PSHI_STATUS_CD IN ('001','005') ORDER BY PSHI_ADD_TS DESC FETCH FIRST 1 ROWS ONLY WITH UR)\r\nLEFT JOIN HS.TCL_TYPE_CD_LOOKUP\tAS PSTS ON PSHI.PSHI_STATUS_CD = PSTS.TCL_TYPE_CODE AND PSTS.TCL_ID = 223\r\nLEFT JOIN HS.TCL_TYPE_CD_LOOKUP\tAS PTYP ON PSHI.PSHI_PAYMENT_TYPE = PTYP.TCL_TYPE_CODE AND PTYP.TCL_ID = 225\r\nLEFT JOIN HS.CSEV_CSV_EV      \tAS CSEV ON CPY.CPY_CLM_ID = CSEV.CSEV_CSV_CLM_ID AND CSEV.CSEV_DEL_TS IS NULL AND CSEV.CSEV_TYPE = 'DN' AND CSEV.CSEV_ADD_TS = (SELECT CSEV_ADD_TS FROM HS.CSEV_CSV_EV WHERE CSEV_DEL_TS IS NULL AND CSEV_CSV_CLM_ID = CSEV.CSEV_CSV_CLM_ID AND CSEV_CSV_LN_NUM = CSEV.CSEV_CSV_LN_NUM ORDER BY CSEV_ADD_TS DESC FETCH FIRST 1 ROWS ONLY WITH UR)\r\nLEFT JOIN HS.CLR_CLM_REL      \tAS CLR ON CPY.CPY_CLM_ID = CLR.CLR_CLM_ID_1 AND CLR.CLR_DEL_TS IS NULL\r\nGROUP BY CLM.CLM_ID, PST.PST_ID, PSHI.PSHI_STATUS_DT, PSHI.PSHI_PAYEE_NAME, PTYP.TCL_TYPE_DESC, PST.PST_AMT, PST.PST_TIMELY_INT_AMT, PSHI.PSHI_TRAN_NUM, PSHI.PSHI_CHECK_AMT, PSHI.PSHI_TRAN_NUM , PSHI.PSHI_CHECK_DT, CASE WHEN CSEV.CSEV_CSV_CLM_ID IS NULL THEN PSTS.TCL_TYPE_DESC WHEN CSEV.CSEV_CSV_CLM_ID IS NOT NULL AND PTYP.TCL_TYPE_DESC = 'CLAIM PAYMENT' THEN 'PARTIAL DENIAL' END\r\n \r\nWITH UR\r\n                                        "
    },
