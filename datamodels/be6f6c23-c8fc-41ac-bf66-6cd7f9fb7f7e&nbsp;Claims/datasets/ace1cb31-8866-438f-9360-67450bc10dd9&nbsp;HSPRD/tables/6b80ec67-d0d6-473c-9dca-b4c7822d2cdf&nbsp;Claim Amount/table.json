    "configOptions": {
        "importQuery": "WITH PAID AS ( \r\nSELECT DISTINCT\r\nCAJ_CLM_ID,\r\nCAM_AMT,\r\n(CAM_AMT -SUM(CAJ_AMT)) AS PAID_AMT\r\nFROM HS.CAM_CLM_AMT\r\nLEFT JOIN HS.CAJ_CLM_ADJ ON CAM_CLM_ID = CAJ_CLM_ID  \r\nWHERE CAM_AMT_QUAL = 'E9'\r\nGROUP BY CAJ_CLM_ID,CAM_AMT\r\nWITH UR), \r\nADJUST AS\r\n(SELECT DISTINCT\r\nCAJ_CLM_ID,\r\nCAJ_AMT,\r\nCAJ_RSN_CD,\r\nCAJ_GRP_CD\r\nFROM HS.CAJ_CLM_ADJ\r\nWHERE CAJ_RSN_CD IN ('UCR','253','CAP')\r\nWITH UR),\r\nCOPAY AS \r\n(SELECT DISTINCT\r\nCAJ_CLM_ID,\r\nSUM(CAJ_AMT) AS COP\r\n\r\nFROM HS.CAJ_CLM_ADJ\r\nWHERE CAJ_GRP_CD = 'PR' AND CAJ_RSN_CD IN (SELECT CTY_TYPE FROM HS.CTY_CNSTRNT_TYPE WHERE CTY_DESC NOT LIKE '%DED%' AND CTY_MIN_MAX NOT IN ('M','R','L') WITH UR)\r\nGROUP BY CAJ_CLM_ID\r\nWITH UR)\r\n\r\nSELECT\r\nCLM.CLM_ID AS CLAIM_ID,\r\nSUM(NVL(PAID.CAM_AMT,0))\tAS CLAIM_BILLED_AMT,\r\nSUM(NVL(UCR.CAJ_AMT,0)) \tAS CLAIM_UCR,\r\nSUM(NVL(ALW.CAM_AMT,0))\t    AS CLAIM_ALLOWED_AMOUNT,\r\nSUM(NVL(DED.CAJ_AMT,0))\t    AS CLAIM_DEDUCTIBLE,\r\nSUM(NVL(COP.COP,0))\t    AS CLAIM_COPAY_COINSURANCE,\r\nSUM(NVL(SEQ.CAJ_AMT,0))  \tAS CLAIM_SEQUESTRATION,\r\nSUM(NVL(CAP.CAJ_AMT,0))     AS CLAIM_CAPITATION,\r\nSUM(NVL(INT.CAM_AMT,0))     AS CLAIM_INTEREST_AMT,\r\nSUM(NVL(PAID.PAID_AMT,0))\tAS CLAIM_PAID_AMT\r\n\r\nFROM\t\tHS.CLM_CLAIM\tAS CLM\t\r\nJOIN        HS.CDT_CLM_DT   AS CDT  ON CLM.CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nLEFT JOIN \tADJUST\t\t\tAS UCR \tON CLM.CLM_ID = UCR.CAJ_CLM_ID AND UCR.CAJ_RSN_CD = 'UCR'\r\nLEFT JOIN\tHS.CAM_CLM_AMT\tAS ALW\tON CLM.CLM_ID = ALW.CAM_CLM_ID AND ALW.CAM_AMT_QUAL = '012'\r\nLEFT JOIN\tHS.CAJ_CLM_ADJ\tAS DED \tON CLM.CLM_ID = DED.CAJ_CLM_ID AND DED.CAJ_RSN_CD IN (SELECT CTY_TYPE FROM HS.CTY_CNSTRNT_TYPE WHERE CTY_DESC LIKE '%DED%' WITH UR)\r\nLEFT JOIN\tCOPAY\tAS COP \tON CLM.CLM_ID = COP.CAJ_CLM_ID \r\nLEFT JOIN \tADJUST\t\t\tAS SEQ \tON CLM.CLM_ID = SEQ.CAJ_CLM_ID AND SEQ.CAJ_RSN_CD = '253'\r\nLEFT JOIN \tADJUST\t\t\tAS CAP \tON CLM.CLM_ID = CAP.CAJ_CLM_ID AND CAP.CAJ_RSN_CD = 'CAP'\r\nLEFT JOIN\tPAID\t\t\tAS PAID\tON CLM.CLM_ID = PAID.CAJ_CLM_ID \r\nLEFT JOIN   HS.CAM_CLM_AMT  AS INT  ON CLM.CLM_ID = INT.CAM_CLM_ID AND INT.CAM_AMT_QUAL IN ('I','004')\r\n\r\nGROUP BY CLM.CLM_ID\r\n\r\nWITH UR\r\n\r\n\r\n\r\n\r\n\r\n"
    },
