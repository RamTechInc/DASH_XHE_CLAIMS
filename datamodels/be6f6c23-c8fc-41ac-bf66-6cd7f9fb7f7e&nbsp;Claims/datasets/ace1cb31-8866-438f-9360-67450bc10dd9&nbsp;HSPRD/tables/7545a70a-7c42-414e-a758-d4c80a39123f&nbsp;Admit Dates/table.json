    "configOptions": {
        "importQuery": "SELECT DISTINCT \nCDT.CDT_CLM_ID AS CLAIM_ID, \nADM.CDT_DT AS \"Admit Date From\", \nADM.CDT_TO_DT AS \"Admit Date To\" \n\nFROM HS.CDT_CLM_DT AS CDT\nLEFT JOIN HS.CDT_CLM_DT AS ADM ON CDT.CDT_CLM_ID = ADM.CDT_CLM_ID AND ADM.CDT_DT_QUAL = '435' \n\nWHERE CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\n\nWITH UR"
