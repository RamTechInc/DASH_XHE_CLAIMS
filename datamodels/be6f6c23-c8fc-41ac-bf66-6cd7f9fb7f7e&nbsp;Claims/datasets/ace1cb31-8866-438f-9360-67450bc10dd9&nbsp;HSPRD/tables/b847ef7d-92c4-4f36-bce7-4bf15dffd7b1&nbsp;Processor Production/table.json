    "configOptions": {
        "importQuery": "SELECT DISTINCT\r\nCEV.CEV_CLM_ID AS CLAIM_ID,\r\nCEV.CEV_ADD_TS AS \"Allowed Status Date\",\r\nCEV.CEV_USER_ID\tAS \"Allowed Processor ID\",\r\nINITCAP(OPR.OPR_NAME) AS \"Processor Name\"\r\n\r\nFROM HS.CEV_CLM_EV AS CEV\r\nJOIN HS.CDT_CLM_DT       AS CDT ON CEV.CEV_CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nJOIN HS.OPR_OPERATOR\tAS OPR ON CEV.CEV_USER_ID = OPR.OPR_ID AND OPR.OPR_DEL_TS IS NULL\r\n\r\nWHERE CEV.CEV_DEL_TS IS NULL\r\nAND CEV.CEV_TYPE = 'ALW'\r\n\r\nWITH UR\r\n"
    },
