    "configOptions": {
        "importQuery": "SELECT\r\nCSEV.CSEV_CSV_CLM_ID AS CLAIM_ID,\r\nCSEV.CSEV_CSV_LN_NUM AS LINE_NUM,\r\nCSEV.CSEV_CSV_CLM_ID || ' ' || CSEV.CSEV_CSV_LN_NUM AS LINE_ID,\r\nINITCAP(TCL.TCL_TYPE_DESC) AS LINE_CUR_STATUS,\r\nCSEV.CSEV_EV_DT AS LINE_STATUS_DT\r\n\r\nFROM HS.CSEV_CSV_EV\tAS CSEV\r\nJOIN HS.CDT_CLM_DT AS CDT ON CSEV.CSEV_CSV_CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR                                  \r\nJOIN HS.TCL_TYPE_CD_LOOKUP AS TCL  ON TRIM(CSEV.CSEV_TYPE) = TCL.TCL_TYPE_CODE AND TCL.TCL_ID = 84\r\nWHERE CSEV.CSEV_DEL_TS IS NULL AND CSEV.CSEV_ADD_TS = (SELECT CSEV_ADD_TS FROM HS.CSEV_CSV_EV WHERE CSEV_DEL_TS IS NULL AND CSEV_CSV_CLM_ID = CSEV.CSEV_CSV_CLM_ID AND CSEV_CSV_LN_NUM = CSEV.CSEV_CSV_LN_NUM ORDER BY CSEV_ADD_TS DESC FETCH FIRST 1 ROWS ONLY WITH UR)\r\nWITH UR"
    },
