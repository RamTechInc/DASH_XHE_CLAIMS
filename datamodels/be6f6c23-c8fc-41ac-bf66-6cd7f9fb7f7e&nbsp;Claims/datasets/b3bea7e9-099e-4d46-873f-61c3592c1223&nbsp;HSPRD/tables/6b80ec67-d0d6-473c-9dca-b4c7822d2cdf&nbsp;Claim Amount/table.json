    "configOptions": {
        "importQuery": "WITH PAID AS (\r\nSELECT DISTINCT\r\nCAJ_CLM_ID,\r\nCAM_AMT,\r\n(CAM_AMT -SUM(CAJ_AMT)) AS PAID_AMT\r\nFROM HS.CAM_CLM_AMT\r\nLEFT JOIN HS.CAJ_CLM_ADJ ON CAM_CLM_ID = CAJ_CLM_ID\r\nWHERE CAM_AMT_QUAL = 'E9'\r\nGROUP BY CAJ_CLM_ID,CAM_AMT\r\nWITH UR),\r\nADJUST AS\r\n(SELECT DISTINCT\r\nCAJ_CLM_ID,\r\nCAJ_AMT,\r\nCAJ_RSN_CD,\r\nCAJ_GRP_CD\r\nFROM HS.CAJ_CLM_ADJ\r\nWHERE CAJ_RSN_CD IN ('UCR','253','CAP')\r\nWITH UR),\r\nCOPAY AS\r\n(SELECT DISTINCT\r\nCAJ_CLM_ID,\r\nSUM(CAJ_AMT) AS COP\r\nFROM HS.CAJ_CLM_ADJ\r\nWHERE CAJ_GRP_CD = 'PR' AND CAJ_RSN_CD IN (SELECT CTY_TYPE FROM HS.CTY_CNSTRNT_TYPE WHERE CTY_DESC NOT LIKE '%DED%' AND CTY_MIN_MAX NOT IN ('M','R','L') WITH UR)\r\nGROUP BY CAJ_CLM_ID\r\nWITH UR),\r\nADDL_UCR AS\r\n(SELECT DISTINCT\r\nCAJ_CLM_ID,\r\nSUM(CAJ_AMT) AS ADDL_UCR\r\nFROM HS.CAJ_CLM_ADJ\r\nWHERE EXISTS (SELECT CSAJ_CSV_CLM_ID FROM HS.CSAJ_CSV_ADJ WHERE CSAJ_CSV_CLM_ID = CAJ_CLM_ID and CSAJ_GRP_CD = CAJ_GRP_CD and CSAJ_RSN_CD = CAJ_RSN_CD AND CSAJ_CMSG_IND = 'Y' and CSAJ_CAT_IND IS NULL)\r\nGROUP BY CAJ_CLM_ID\r\nWITH UR)\r\nSELECT\r\nCLM.CLM_ID AS CLAIM_ID,\r\nSUM(NVL(PAID.CAM_AMT,0)) AS CLAIM_BILLED_AMT,\r\nSUM(NVL(UCR.CAJ_AMT,0)) + SUM(NVL(ADDL_UCR_ADJ.ADDL_UCR,0)) AS CLAIM_UCR,\r\nSUM(NVL(PAID.CAM_AMT,0)) - (SUM(NVL(UCR.CAJ_AMT,0)) + SUM(NVL(ADDL_UCR_ADJ.ADDL_UCR,0))) AS CLAIM_ALLOWED_AMOUNT,\r\nSUM(NVL(DED.CAJ_AMT,0)) AS CLAIM_DEDUCTIBLE,\r\nSUM(NVL(COP.COP,0)) AS CLAIM_COPAY_COINSURANCE,\r\nSUM(NVL(SEQ.CAJ_AMT,0)) AS CLAIM_SEQUESTRATION,\r\nSUM(NVL(CAP.CAJ_AMT,0)) AS CLAIM_CAPITATION,\r\nSUM(NVL(INT.CAM_AMT,0)) AS CLAIM_INTEREST_AMT,\r\nSUM(NVL(PAID.PAID_AMT,0)) AS CLAIM_PAID_AMT\r\nFROM HS.CLM_CLAIM AS CLM\r\nJOIN HS.CDT_CLM_DT AS CDT ON CLM.CLM_ID = CDT.CDT_CLM_ID AND CDT.CDT_DT_QUAL = '050' AND CDT.CDT_DT >= CURRENT_DATE - 2 YEAR\r\nLEFT JOIN ADJUST AS UCR ON CLM.CLM_ID = UCR.CAJ_CLM_ID AND UCR.CAJ_GRP_CD = 'NC' AND UCR.CAJ_RSN_CD = 'UCR'\r\nLEFT JOIN HS.CAJ_CLM_ADJ AS DED ON CLM.CLM_ID = DED.CAJ_CLM_ID AND DED.CAJ_RSN_CD IN (SELECT CTY_TYPE FROM HS.CTY_CNSTRNT_TYPE WHERE CTY_DESC LIKE '%DED%' WITH UR)\r\nLEFT JOIN COPAY AS COP ON CLM.CLM_ID = COP.CAJ_CLM_ID\r\nLEFT JOIN ADJUST AS SEQ ON CLM.CLM_ID = SEQ.CAJ_CLM_ID AND SEQ.CAJ_RSN_CD = '253'\r\nLEFT JOIN ADJUST AS CAP ON CLM.CLM_ID = CAP.CAJ_CLM_ID AND CAP.CAJ_RSN_CD = 'CAP'\r\nLEFT JOIN PAID AS PAID ON CLM.CLM_ID = PAID.CAJ_CLM_ID\r\nLEFT JOIN ADDL_UCR AS ADDL_UCR_ADJ ON CLM.CLM_ID = ADDL_UCR_ADJ.CAJ_CLM_ID\r\nLEFT JOIN HS.CAM_CLM_AMT AS INT ON CLM.CLM_ID = INT.CAM_CLM_ID AND INT.CAM_AMT_QUAL IN ('I','004')\r\nGROUP BY CLM.CLM_ID"
    },
